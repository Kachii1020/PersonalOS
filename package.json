{
  "name": "personalos",
  "version": "1.0.0",
  "description": "커리어 학습, 스케줄, 시사·금융 정보, 투자 리서치, SWE 실무 지식을 한 곳에서 관리하는 단일 사용자용 대시보드.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:reset": "tsx scripts/gen-seed.ts && supabase db reset",
    "test:g1": "node --import tsx --conditions=react-server --test tests/gates/g1.test.ts",
    "notion:check": "node --import tsx --conditions=react-server scripts/check-notion.ts",
    "test:g2": "node --import tsx --conditions=react-server --test tests/gates/g2.test.ts",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "test": "npm run test:unit && npm run test:g1 && npm run test:g2"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.10.1",
    "fflate": "^0.8.3",
    "ical-generator": "^11.1.0",
    "ical.js": "^2.2.1",
    "lucide-react": "^1.28.0",
    "next": "15.5.22",
    "pretendard": "^1.3.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "tsdav": "^2.3.1",
    "unpdf": "^1.8.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.22",
    "supabase": "^2.111.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.4",
    "typescript": "^5"
  },
  "private": true
}
